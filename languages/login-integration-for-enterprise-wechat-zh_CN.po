#. Name of the plugin
msgid "Login Integration for Enterprise WeChat"
msgstr "企业微信登录集成"

#. Description of the plugin
msgid "Enterprise WeChat (WeCom) login with QR code and in-app authorization."
msgstr "企业微信登录：支持扫码登录和应用内授权。"

#: login-integration-for-enterprise-wechat.php
msgid "Settings"
msgstr "设置"

#: login-integration-for-enterprise-wechat.php
msgid "Login with Enterprise WeChat"
msgstr "企业微信登录"

#: login-integration-for-enterprise-wechat.php
msgid "Enterprise WeChat Login Settings"
msgstr "设置企业微信登录参数"

#: login-integration-for-enterprise-wechat.php
msgid "Enterprise WeChat Login"
msgstr "企业微信登录"

#: login-integration-for-enterprise-wechat.php
msgid "Enter your Enterprise WeChat application details. See the login instructions for help."
msgstr "请输入企业微信应用参数，详情请参考登录说明。"

#: login-integration-for-enterprise-wechat.php
msgid "Login instructions"
msgstr "登录说明"

#: login-integration-for-enterprise-wechat.php
msgid "CorpId/AppId"
msgstr "企业ID"

#: login-integration-for-enterprise-wechat.php
msgid "AgentId"
msgstr "自建应用ID"

#: login-integration-for-enterprise-wechat.php
msgid "CorpSecret"
msgstr "密钥"

#: login-integration-for-enterprise-wechat.php
msgid "Auto Register"
msgstr "自动注册新用户"

#: login-integration-for-enterprise-wechat.php
msgid "Default Role of New User"
msgstr "新用户默认权限"

#: login-integration-for-enterprise-wechat.php
msgid "Disable Default Login"
msgstr "禁用系统默认登录"

#: login-integration-for-enterprise-wechat.php
msgid "Warning: This replaces password login. Disable the plugin if Enterprise WeChat login is unavailable."
msgstr "警告：启用后将替代密码登录。如果企业微信登录不可用，请禁用本插件。"
